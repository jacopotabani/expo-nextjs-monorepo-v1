{
  "name": "@acme/ui",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "ui:add": "npx gluestack-ui add"
  },
  "devDependencies": {
    "@acme/eslint": "workspace:*",
    "@acme/typescript": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/react": "~19.0.0",
    "@types/react-dom": "~19.0.0",
    "eslint": "^9.30.0",
    "typescript": "5.8.2"
  },
  "dependencies": {
    "@gluestack-ui/core": "^3.0.2",
    "@gluestack-ui/icon": "^0.1.27",
    "@gluestack-ui/image": "^0.1.17",
    "@gluestack-ui/link": "^0.1.29",
    "@gluestack-ui/nativewind-utils": "^1.0.28",
    "@gluestack-ui/overlay": "^0.1.22",
    "@gluestack-ui/toast": "^1.0.9",
    "nativewind": "~4.1.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "0.79.5",
    "react-native-css-interop": "^0.1.22",
    "react-native-svg": "^15.11.2",
    "react-native-web": "~0.20.0",
    "tailwindcss": "^4.1.11"
  },
  "sideEffects": [
    "./src/lib/globals.css"
  ],
  "main": "./src/gluestack-ui-provider/index.tsx",
  "types": "./src/gluestack-ui-provider/index.tsx",
  "exports": {
    ".": "./src/gluestack-ui-provider/index.tsx",
    "./globals.css": "./src/lib/globals.css",
    "./lib/*": "./src/lib/*.ts",
    "./components/accordion": "./src/components/accordion/index.tsx",
    "./components/badge": "./src/components/badge/index.tsx",
    "./components/button": {
      "react-native": "./src/components/button/index.tsx",
      "default": "./src/components/button/index.web.tsx"
    },
    "./components/card": {
      "react-native": "./src/components/card/index.tsx",
      "default": "./src/components/card/index.web.tsx"
    },
    "./components/checkbox": {
      "react-native": "./src/components/checkbox/index.tsx",
      "default": "./src/components/checkbox/index.web.tsx"
    },
    "./components/heading": {
      "react-native": "./src/components/heading/index.tsx",
      "default": "./src/components/heading/index.web.tsx"
    },
    "./components/hstack": {
      "react-native": "./src/components/hstack/index.tsx",
      "default": "./src/components/hstack/index.web.tsx"
    },
    "./components/icon": "./src/components/icon/index.tsx",
    "./components/image": "./src/components/image/index.tsx",
    "./components/input": {
      "react-native": "./src/components/input/index.tsx",
      "default": "./src/components/input/index.web.tsx"
    },
    "./components/label": {
      "react-native": "./src/components/label/index.tsx",
      "default": "./src/components/label/index.web.tsx"
    },
    "./components/link": "./src/components/link/index.tsx",
    "./components/text": "./src/components/text/index.tsx",
    "./components/*": [
      "./src/components/*.tsx",
      "./src/components/*.ts",
      "./src/components/*/index.tsx",
      "./src/components/*/index.web.tsx"
    ],
    "./hooks/*": "./src/hooks/*.ts",
    "./gluestack-ui-provider": {
      "react-native": "./gluestack-ui-provider.tsx",
      "default": "./gluestack-ui-provider.web.tsx"
    },
    "./gluestack-ui-provider/config": "./src/gluestack-ui-provider/config.ts"
  }
}
